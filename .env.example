# Configuração do Supabase client (consumido pelo Vite).
#
# Desde a consolidação dos projetos, a wishlist NÃO tem mais projeto Supabase
# próprio: usa o mesmo projeto do app-produtividade, num schema dedicado
# (`wishlist`). Ver supabase/migrations/0005_consolidate_into_shared_project.sql.
#
# Projeto antigo (desativado após a validação): jwmuwogwutiiuvewhkku
VITE_SUPABASE_URL=https://robwqxgllzxbxwnjkyic.supabase.co

# Chave publicável do projeto consolidado — Project Settings > API Keys.
# Pode ser pública: o RLS garante que cada pessoa só acessa os próprios dados.
# É a mesma que os workflows usam, então dá para copiar como está.
VITE_SUPABASE_ANON_KEY=sb_publishable_ver9EeXJEKDvDGpY7TRACw_sVVY6aoF

# ---- Usada só pelo CI que publica o APK (scripts/publicar-supabase.mjs) ----
# service_role key do projeto consolidado — bypassa RLS, nunca vai no cliente.
SUPABASE_SERVICE_ROLE_KEY=
